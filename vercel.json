{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "helpers": {
      "root": "vercel-helpers",
      "framework": "express",
      "entrypoint": "app.js",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_INTERNAL_URL"
        }
      ]
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api:app",
      "functions": {
        "api.py": {
          "includeFiles": "{cervical_validator.pth,phase2_resnet18_best.pth,data/facilities.json}",
          "excludeFiles": "{frontend/**,vercel-helpers/**,dataset/**,storage/**,cervical_records.db*,docs/**,scripts/**,tests/**,node_modules/**}",
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/blob-upload", "destination": { "service": "helpers" } },
    { "source": "/api/private-asset", "destination": { "service": "helpers" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/analyze", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
